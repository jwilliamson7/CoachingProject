__pycache__/
*.pyc
~$*

# Supermemory local container config (personal tag — do not commit)
.claude/.supermemory-claude/

# Scratch/safety backups (LEAKY/overfit/era snapshots; not reproducible artifacts)
*.bak
data/master_data_4block_backup.csv

# LaTeX build artifacts (manuscript source is the .tex; compiled output is reproducible)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz
papers/jse/*.log
papers/jse/_build_*.log
papers/jse/*.pdf
papers/*/*.zip

# Journal decision letters and reviewer reports (confidential; never commit)
papers/*/feedback/

# Run logs and generated analysis artifacts (reproducible from the scripts)
analysis/_*.log
analysis/_*.json
analysis/_stability_2000.pkl
analysis/survival_selection_probe.pkl
analysis/survival_magnitude.pkl
analysis/internal_hire_audit_summary.csv
analysis/internal_hire_history_detail.csv

# Literature library: publisher, working-paper and web copies are copyrighted and this repo is
# public, so only the index and our own reading notes are tracked. The files themselves are
# backed up privately (Egnyte: Private/jonwilliamson/Personal/Research/CoachingProject).
literature/**
!literature/
!literature/INDEX.md
!literature/notes/
!literature/notes/*.md

# Personal Claude Code settings (machine-local permissions)
.claude/settings.local.json

# Responses to reviewers quote the confidential reports (see papers/*/feedback/ above)
papers/**/*[Rr]esponse*.docx
